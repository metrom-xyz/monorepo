{
    "type": "module",
    "private": true,
    "name": "curve-subgraph",
    "scripts": {
        "prepare:deploy": "tsx ./scripts/prepare-deploy.ts",
        "codegen": "graph codegen",
        "create:local": "graph create metrom-curve-local --node http://localhost:8020",
        "deploy:local": "pnpm prepare:deploy mainnet && pnpm codegen && graph deploy metrom-curve-local --node http://localhost:8020 --ipfs http://localhost:5001 -l 0.0.1",
        "deploy:mainnet": "pnpm prepare:deploy mainnet && pnpm codegen && graph deploy metrom-curve-mainnet -l 0.0.130",
        "lint": "eslint .",
        "format": "eslint --fix ."
    },
    "dependencies": {
        "@0xgraph/cli": "^0.2.1",
        "@graphprotocol/graph-cli": "catalog:",
        "@graphprotocol/graph-ts": "catalog:"
    },
    "devDependencies": {
        "@eslint/js": "catalog:",
        "@types/mustache": "catalog:",
        "@types/node": "catalog:",
        "eslint": "catalog:",
        "eslint-config-prettier": "catalog:",
        "eslint-plugin-prettier": "catalog:",
        "mustache": "catalog:",
        "prettier": "catalog:",
        "tsx": "catalog:",
        "typescript": "catalog:",
        "typescript-eslint": "catalog:",
        "viem": "catalog:"
    }
}
