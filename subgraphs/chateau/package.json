{
    "type": "module",
    "private": true,
    "name": "chateau-subgraph",
    "scripts": {
        "prepare:deploy": "tsx ./scripts/prepare-deploy.ts",
        "codegen": "graph codegen",
        "create:local": "graph create metrom-curve-local --node http://localhost:8020",
        "deploy:local": "pnpm prepare:deploy plasma-mainnet && pnpm codegen && graph deploy metrom-curve-local --node http://localhost:8020 --ipfs http://localhost:5001 -l 0.0.1",
        "deploy:plasma": "pnpm prepare:deploy plasma-mainnet && pnpm codegen && graph build && goldsky subgraph deploy metrom-chateau-plasma/0.0.1",
        "lint": "eslint .",
        "format": "eslint --fix ."
    },
    "dependencies": {
        "@graphprotocol/graph-cli": "catalog:",
        "@graphprotocol/graph-ts": "catalog:"
    },
    "devDependencies": {
        "@eslint/eslintrc": "catalog:",
        "@eslint/js": "catalog:",
        "@types/mustache": "catalog:",
        "@types/node": "catalog:",
        "eslint": "catalog:",
        "eslint-config-prettier": "catalog:",
        "eslint-plugin-prettier": "catalog:",
        "mustache": "catalog:",
        "prettier": "catalog:",
        "tsx": "catalog:",
        "typescript": "catalog:",
        "typescript-eslint": "catalog:",
        "viem": "catalog:"
    }
}
